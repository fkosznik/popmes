# Use python3 scripts/setup.py to generate real random secrets.
DJANGO_SECRET_KEY=
DEBUG=0
POSTGRES_DB=popmes
POSTGRES_USER=popmes
POSTGRES_PASSWORD=
POSTGRES_HOST=database
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SEED_CATALOG=1
BIND_IP=127.0.0.1
APP_PORT=8080
# POPMES_ENV=local
# Production (compose.prod.yaml) requires these and does not fall back to the superuser:
