# POSTGRES_APP_PASSWORD=
# POSTGRES_MIGRATE_USER=popmes_migrate
# POSTGRES_MIGRATE_PASSWORD=
# LOGIN_IP_LIMIT=30
# LOGIN_ACCOUNT_LIMIT=10
# OFFSITE_REQUIRED=0
# HEALTHCHECK_URL=
# DOMAIN=popmes.example.com
# USE_HTTPS=1
# HSTS for this host only. Do not set INCLUDE_SUBDOMAINS unless every subdomain serves HTTPS.
# SECURE_HSTS_SECONDS=15552000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
