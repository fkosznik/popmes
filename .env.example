# RESTIC_KEEP_WEEKLY=8
# RESTIC_KEEP_MONTHLY=12
# BACKUP_KEEP=14
# BACKUP_DIR=./backups
# ALERT_WEBHOOK_URL=
# DISK_ALERT_PERCENT=90
